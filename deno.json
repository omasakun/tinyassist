{
  "workspace": [
    "./packages/tinyassist-deno"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "setup": "deno install --allow-scripts && deno task setup:lefthook",
    "setup:lefthook": "lefthook install",
    "fmt": "deno fmt && cargo fmt",
    "lint": "deno lint && cargo clippy"
  },
  "imports": {
    "lefthook": "npm:lefthook@^1.13.6"
  },
  "fmt": {
    "lineWidth": 120,
    "proseWrap": "preserve"
  }
}
